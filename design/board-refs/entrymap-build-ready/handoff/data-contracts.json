{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EntryMap UI data contracts",
  "version": 1,
  "$defs": {
    "TrustTier": { "enum": ["Estimated", "Scanned on-site", "Owner-confirmed"] },
    "MatchResult": { "enum": ["good", "partial", "unknown"] },
    "FeatureName": { "enum": ["Step-free entry", "Ramp visible", "Auto door button", "Easy-grip handle", "Wide door", "Accessibility signage", "Clear approach"] },
    "NeedsProfileItem": { "enum": ["wheelchair", "cane-walker", "low-vision", "limited-grip", "stroller"] },
    "EvidenceMethod": { "enum": ["photo-scan", "community-report", "owner-attestation", "public-record", "state-record"] },
    "Confidence": { "type": "integer", "minimum": 1, "maximum": 3 },
    "Business": {
      "type": "object", "required": ["id", "name"],
      "properties": { "id": {"type":"string"}, "name": {"type":"string"}, "category": {"type":"string"}, "entranceIds": {"type":"array","items":{"type":"string"}} }
    },
    "Entrance": {
      "type": "object", "required": ["id", "businessId", "coordinate", "trustTier", "featureClaims"],
      "properties": {
        "id":{"type":"string"}, "businessId":{"type":"string"},
        "coordinate":{"type":"object","required":["latitude","longitude"],"properties":{"latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180}}},
        "trustTier":{"$ref":"#/$defs/TrustTier"}, "featureClaims":{"type":"array","items":{"$ref":"#/$defs/FeatureClaim"}},
        "selected":{"type":"boolean","description":"Transient presentation state; never stored as evidence."},
        "clustered":{"type":"boolean","description":"Transient map state; never changes trust."}
      }
    },
    "AccessibilityProfile": {
      "type":"object", "required":["items","storage"],
      "properties":{"items":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/NeedsProfileItem"}},"storage":{"enum":["local-guest","account-synced"]}}
    },
    "FeatureClaim": {
      "type":"object", "required":["id","entranceId","feature","status","receiptIds"],
      "properties":{"id":{"type":"string"},"entranceId":{"type":"string"},"feature":{"$ref":"#/$defs/FeatureName"},"status":{"enum":["seen","not-yet-seen"]},"observedAt":{"type":["string","null"],"format":"date-time"},"confidence":{"anyOf":[{"$ref":"#/$defs/Confidence"},{"type":"null"}]},"receiptIds":{"type":"array","items":{"type":"string"}}}
    },
    "EvidenceSource": {
      "type":"object", "required":["id","method","label"],
      "properties":{"id":{"type":"string"},"method":{"$ref":"#/$defs/EvidenceMethod"},"label":{"type":"string"},"observedAt":{"type":["string","null"],"format":"date-time"},"sourceUrl":{"type":["string","null"],"format":"uri"},"witnessCount":{"type":"integer","minimum":0},"readOnly":{"type":"boolean"}}
    },
    "EvidenceReceipt": {
      "type":"object", "required":["id","entranceId","sourceIds","provenanceLines","confidence"],
      "properties":{"id":{"type":"string"},"entranceId":{"type":"string"},"photoUrl":{"type":["string","null"],"format":"uri"},"sourceIds":{"type":"array","minItems":1,"items":{"type":"string"}},"provenanceLines":{"type":"array","minItems":1,"items":{"type":"string"}},"confidence":{"$ref":"#/$defs/Confidence"},"freshness":{"$ref":"#/$defs/Freshness"}}
    },
    "Freshness": {
      "type":"object", "required":["observedAt","ageDays","state","displayText"],
      "properties":{"observedAt":{"type":"string","format":"date-time"},"ageDays":{"type":"integer","minimum":0},"state":{"enum":["current","aging","recheck"]},"displayText":{"type":"string","description":"Must describe time and an optional re-check action; never grade the place."}}
    },
    "CorrectionSuggestion": {
      "type":"object", "required":["id","entranceId","category","note","status"],
      "properties":{"id":{"type":"string"},"entranceId":{"type":"string"},"category":{"type":"string"},"note":{"type":"string","maxLength":300},"photoUrl":{"type":["string","null"],"format":"uri"},"status":{"enum":["draft","queued","sent","reviewed"]}}
    },
    "ScanSession": {
      "type":"object", "required":["id","entranceId","status","completedChecks"],
      "properties":{"id":{"type":"string"},"entranceId":{"type":"string"},"status":{"enum":["primer","camera","processing","review","queued-offline","published"]},"completedChecks":{"type":"array","items":{"enum":["Doorway framed","Entry path visible","Entrance features checked","Photo quality checked"]}},"confirmedFeatures":{"type":"array","items":{"$ref":"#/$defs/FeatureName"}}}
    },
    "OwnerClaim": {
      "type":"object", "required":["id","entranceId","accountId","role","contactMethod","authorizationAccepted","status"],
      "properties":{"id":{"type":"string"},"entranceId":{"type":"string"},"accountId":{"type":"string"},"role":{"type":"string"},"contactMethod":{"enum":["business-email","business-phone"]},"authorizationAccepted":{"const":true},"status":{"enum":["submitted","business-matched","ownership-review","approved","declined"]}}
    },
    "PublicRecord": {
      "type":"object", "required":["id","entranceId","jurisdiction","year","label","readOnly"],
      "properties":{"id":{"type":"string"},"entranceId":{"type":"string"},"jurisdiction":{"type":"string"},"year":{"type":"integer","minimum":1900},"label":{"type":"string"},"readOnly":{"const":true}}
    }
  }
}
